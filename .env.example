# ============================================================
# SignFlow — Variáveis de Ambiente
# Copie este arquivo para .env e ajuste os valores
# ============================================================

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://signflow:signflow123@localhost:5432/signflow
DATABASE_URL_SYNC=postgresql://signflow:signflow123@localhost:5432/signflow

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# MinIO / S3
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=signflow-media
MINIO_SECURE=false

# JWT
JWT_SECRET_KEY=mude-esta-chave-secreta-em-producao-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Clima (Open-Meteo — gratuito, sem API key)
WEATHER_LAT=-22.1256
WEATHER_LON=-51.3889
WEATHER_CITY=Presidente Prudente
WEATHER_CACHE_TTL=600

# Uploads
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Ambiente
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=info

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000/signflow-media
