[Unit]
Description=SignFlow Kiosk (cage + Chromium em tela cheia)
After=systemd-user-sessions.service plymouth-quit-wait.service network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
User=__KIOSK_USER__
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# Tema de cursor transparente (gerado pelo install.sh): esconde a seta do mouse
Environment=XCURSOR_THEME=signflow-blank
Environment=XCURSOR_SIZE=24
ExecStart=/usr/bin/cage -d -s -- /opt/signflow-agent/kiosk-browser.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
